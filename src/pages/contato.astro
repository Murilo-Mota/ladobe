---
import Base from "../layouts/Base.astro";
import Carrossel from "../components/Carrossel.astro";
import { assuntos as carregarAssuntos, empresa as carregarEmpresa } from "../lib/dados";
import { digitos, linkWhatsapp } from "../lib/formatos";
const empresa = await carregarEmpresa();
const assuntos = await carregarAssuntos();
---
<Base titulo="Contato">
  <Carrossel id="contato" />
  <section class="secao-creme">
    <img class="folha folha--esq" src="/img/folha-creme-esq.png" alt="">
    <header class="secao-titulo">
      <p class="entrelinhas">Contato</p>
      <h2>Vamos conversar</h2>
    </header>
    <div class="contato">
      <div class="contato__cartoes">
        {empresa.telefones.length > 0 && (
        <div class="info">
          <h3>Telefones</h3>
          <ul>
            {empresa.telefones.map((t) => (
              <li><span>{t.rotulo}</span>
                <a href={t.whatsapp ? linkWhatsapp(t.numero) : `tel:${digitos(t.numero)}`}>{t.numero}{t.whatsapp && " · WhatsApp"}</a></li>
            ))}
          </ul>
        </div>
        )}
        {empresa.emails.length > 0 && (
        <div class="info">
          <h3>E-mails</h3>
          <ul>{empresa.emails.map((e) => <li><span>{e.rotulo}</span><a href={`mailto:${e.email}`}>{e.email}</a></li>)}</ul>
        </div>
        )}
        {empresa.enderecos.length > 0 && (
        <div class="info">
          <h3>Endereços</h3>
          <ul>{empresa.enderecos.map((e) => (
            <li><span>{e.rotulo}</span>{[e.logradouro, e.numero, e.complemento].filter(Boolean).join(", ")}<br />{[e.bairro, `${e.cidade}/${e.uf}`, e.cep].filter(Boolean).join(" · ")}</li>
          ))}</ul>
        </div>
        )}
        {empresa.horarios.length > 0 && (
        <div class="info">
          <h3>Horários</h3>
          <ul>{empresa.horarios.map((h) => <li><span>{h.dias}</span>{h.horario}</li>)}</ul>
        </div>
        )}
      </div>

      <form id="form-contato" class="formulario" method="post" action="/api/contato/" data-form-contato novalidate>
        <h3>Envie sua mensagem</h3>
        <p class="sucesso" role="status" data-sucesso hidden>Mensagem enviada. Obrigado pelo contato!</p>
        <p class="campo--largo aviso" role="alert" data-falha hidden>Não foi possível enviar agora. Tente de novo ou fale pelo WhatsApp.</p>
        <div class="campo-oculto" aria-hidden="true"><label>Site <input name="site" tabindex="-1" autocomplete="off"></label></div>
        <div class="campo" data-campo="nome">
          <label for="id_nome">Nome *</label>
          <input id="id_nome" name="nome" maxlength="120" required autocomplete="name">
          <small hidden></small>
        </div>
        <div class="campo" data-campo="email">
          <label for="id_email">E-mail *</label>
          <input id="id_email" name="email" type="email" maxlength="254" required autocomplete="email">
          <small hidden></small>
        </div>
        <div class="campo" data-campo="telefone">
          <label for="id_telefone">Telefone</label>
          <input id="id_telefone" name="telefone" maxlength="25" autocomplete="tel" inputmode="tel">
          <small hidden></small>
        </div>
        <div class="campo" data-campo="assunto">
          <label for="id_assunto">Assunto</label>
          <select id="id_assunto" name="assunto">
            <option value="">Selecione</option>
            {assuntos.map((a) => <option>{a.nome}</option>)}
          </select>
          <small hidden></small>
        </div>
        <div class="campo campo--largo" data-campo="mensagem">
          <label for="id_mensagem">Mensagem *</label>
          <textarea id="id_mensagem" name="mensagem" rows="5" maxlength="5000" required></textarea>
          <small hidden></small>
        </div>
        <button class="botao botao--vinho" type="submit">Enviar mensagem</button>
      </form>
    </div>
    {empresa.mapa_url && (
      <iframe class="mapa" src={empresa.mapa_url} title="Mapa" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    )}
  </section>
</Base>
