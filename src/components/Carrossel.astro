---
// Uso em qualquer página: <Carrossel id="identificador" />  (identificador = nome do arquivo em src/content/carrosseis)
import { getImage } from "astro:assets";
import { carrossel } from "../lib/dados";

interface Props { id?: string }
const c = await carrossel(Astro.props.id);

const larguras = (largura: number, opcoes: number[]) => {
  const w = opcoes.filter((x) => x < largura);
  return [...w, Math.min(largura, opcoes.at(-1)!)];
};

const banners = c
  ? await Promise.all(
      c.banners.map(async (b, i) => {
        const desktop = await getImage({ src: b.imagem, widths: larguras(b.imagem.width, [960, 1600, 2400]), format: "webp", quality: 84 });
        const mobile = b.imagem_mobile
          ? await getImage({ src: b.imagem_mobile, widths: larguras(b.imagem_mobile.width, [600, 1200]), format: "webp", quality: 84 })
          : undefined;
        const nome = [b.titulo, b.titulo_destaque].filter(Boolean).join(" ") || `Banner ${i + 1}`;
        const temConteudo = [b.sobretitulo, b.titulo, b.titulo_destaque, b.texto, b.texto_botao].some(Boolean);
        return { ...b, desktop, mobile, nome, temConteudo };
      }),
    )
  : [];
---
{c && (
<section class={`carrossel carrossel--${c.tamanho}`} data-carrossel data-autoplay={c.autoplay ? "1" : "0"}
  data-transicao={c.transicao} style={`--intervalo:${c.intervalo}s`}
  aria-roledescription="carrossel" aria-label={c.nome} tabindex="0">
  {banners.map((b, i) => (
  <article class:list={["slide", { ativo: i === 0, "slide--arte": !b.temConteudo }]} data-slide
    data-inicio={b.inicio?.toISOString()} data-fim={b.fim?.toISOString()}
    aria-roledescription="slide" aria-label={`${i + 1} de ${banners.length}`}>
    <picture>
      {b.mobile && <source media="(max-width: 700px)" srcset={b.mobile.srcSet.attribute} sizes="100vw" />}
      <img src={b.desktop.src} srcset={b.desktop.srcSet.attribute} sizes="100vw" alt={b.nome} draggable="false"
        style={`object-position:${b.foco}`} fetchpriority={i === 0 ? "high" : undefined} loading={i === 0 ? undefined : "lazy"} />
    </picture>
    {b.temConteudo ? (
    <div class="slide__conteudo">
      {b.sobretitulo && <p class="sobretitulo">{b.sobretitulo}</p>}
      {(b.titulo || b.titulo_destaque) && <>
        <h1 class="slide__titulo">{b.titulo}{b.titulo_destaque && <> <em>{b.titulo_destaque}</em></>}</h1>
        <div class="filete" aria-hidden="true"></div>
      </>}
      {b.texto && <p class="slide__texto">{b.texto}</p>}
      {b.texto_botao && b.link && (
        <a class="botao" href={b.link}>{b.texto_botao}<span class="botao__selo" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.400" stroke-linecap="round"><path d="M12 3c-5 3-8 8-7 12 1 3.500 4 6 7 6s6-2.500 7-6c1-4-2-9-7-12Z"/><path d="M12 3v18"/></svg>
        </span></a>
      )}
    </div>
    ) : b.link && <a class="slide__link" href={b.link} aria-label={b.nome}></a>}
  </article>
  ))}

  {banners.length > 1 && <>
  <button class="seta seta--ant" type="button" data-anterior aria-label="Banner anterior">‹</button>
  <button class="seta seta--prox" type="button" data-proximo aria-label="Próximo banner">›</button>
  <div class="pontos">
    {banners.map((_, i) => (
      <button type="button" class:list={["ponto", { ativo: i === 0 }]} data-ponto aria-label={`Ir para o banner ${i + 1}`}><span></span></button>
    ))}
  </div>
  </>}
</section>
)}
